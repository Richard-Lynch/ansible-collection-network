# Rendered by roles/service_headscale — static config for the TLS front of Headscale ONLY.
# No dashboard, no API, no docker provider: this traefik routes exactly one hostname.
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO

entryPoints:
  headscale:
    address: ":{{ headscale_server_port }}"
    transport:
      respondingTimeouts:
        # The Tailscale control and DERP connections are long-lived upgraded streams. Traefik v3
        # defaults readTimeout to 60s, which would cut every client off once a minute.
        readTimeout: 0s
        idleTimeout: 0s

providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

certificatesResolvers:
  le:
    acme:
      email: {{ headscale_acme_email }}
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
