# Rendered by roles/service_headscale.
services:
  headscale:
    image: {{ headscale_image }}
    restart: unless-stopped
    command: serve
    read_only: true
    # Host networking: STUN must see the client's real source address and port, which Docker's
    # userland proxy / NAT would rewrite. Every TCP listener in config.yaml is bound to loopback.
    network_mode: host
    volumes:
      - ./config:/etc/headscale:ro
      - ./lib:/var/lib/headscale
      - ./run:/var/run/headscale
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 30s
      timeout: 5s
      retries: 3

  traefik:
    image: {{ headscale_traefik_image }}
    restart: unless-stopped
    network_mode: host
    env_file: ./traefik.env
    command: ["--configFile=/etc/traefik/traefik.yml"]
    volumes:
      - ./traefik:/etc/traefik:ro
      - ./letsencrypt:/letsencrypt
