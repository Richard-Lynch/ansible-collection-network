services:
  {{ traefik_container_name }}:
    container_name: '{{ traefik_container_name }}'
    image: '{{ traefik_image }}'
    restart: 'unless-stopped'
    env_file: 'app.env'
{# EXPLICIT log rotation, not inherited. A daemon default in /etc/docker/daemon.json applies
   only to containers created AFTER it was set, so a container that predates it logs without
   limit (`docker inspect` shows `LogConfig.Config = map[]`), and unbounded log I/O degrades the
   host in ways that do not look like logging.

   Declaring it here makes the bound a property of THIS service rather than of when its
   container happened to be created, so a rebuild cannot silently lose it. See the log-volume
   note in config/traefik.yml for the other half of that fix. #}
    logging:
      driver: json-file
      options:
        max-size: '50m'
        max-file: '3'
    ports:
      - {{ (traefik_bind_address ~ ':') if traefik_bind_address | length > 0 else '' }}{{ traefik_http_port }}:80
      - {{ (traefik_bind_address ~ ':') if traefik_bind_address | length > 0 else '' }}{{ traefik_https_port }}:443
    networks:
      {{ traefik_network }}: {}
{% if traefik_forward_auth_network | length > 0 %}
{# The dedicated network to the forward-auth service, at the fixed address it accepts callers from. #}
      {{ traefik_forward_auth_network }}:
        ipv4_address: {{ traefik_forward_auth_traefik_ip }}
{% endif %}
    volumes:
      - '/var/run/docker.sock:/var/run/docker.sock'
      - '{{ traefik_config_dir }}/config:/etc/traefik:ro'
      # ACME cert store (runtime state — private keys; imported, never in the repo)
      - '{{ traefik_config_dir }}/letsencrypt:/letsencrypt'
    labels:
      traefik.enable: 'true'
      traefik.http.routers.traefik.rule: 'Host(`{{ traefik_dashboard_host }}`) && (PathPrefix(`/api`) || PathPrefix(`/dashboard`))'
      traefik.http.routers.traefik.entrypoints: web
      traefik.http.routers.traefik.middlewares: "traefik-https-redirect@file"

      # router that matches the site root ONLY
      traefik.http.routers.root-redirect.rule: Host(`{{ traefik_dashboard_host }}`) && Path(`/`) || Path(`/dashboard`)
      traefik.http.routers.root-redirect.entrypoints: websecure
      traefik.http.routers.root-redirect.tls: true
      traefik.http.routers.root-redirect.priority: -100
      traefik.http.routers.root-redirect.middlewares: dashboard-redirect@docker
      traefik.http.routers.root-redirect.service: noop@internal

      traefik.http.middlewares.dashboard-redirect.redirectregex.regex: ^(https?://[^/]+)/(dashboard)?$
      traefik.http.middlewares.dashboard-redirect.redirectregex.replacement: $${1}/dashboard/
      traefik.http.middlewares.dashboard-redirect.redirectregex.permanent: "false"

      # HTTPS router (dashboard/api) + wildcard cert
      traefik.http.routers.traefik-secure.entrypoints: websecure
      traefik.http.routers.traefik-secure.rule: 'Host(`{{ traefik_dashboard_host }}`) && ((PathPrefix(`/api/`) || PathPrefix(`/dashboard/`)))'
      traefik.http.routers.traefik-secure.service: api@internal
      traefik.http.routers.traefik-secure.middlewares: ""
      traefik.http.routers.traefik-secure.tls: true
      traefik.http.routers.traefik-secure.tls.certresolver: {{ traefik_acme_resolver }}
      traefik.http.routers.traefik-secure.tls.domains[0].main: {{ traefik_cert_domain }}
      traefik.http.routers.traefik-secure.tls.domains[0].sans: "{{ traefik_cert_sans }}"

networks:
  {{ traefik_network }}:
    external: true
{% if traefik_forward_auth_network | length > 0 %}
  {{ traefik_forward_auth_network }}:
    external: true
{% endif %}
